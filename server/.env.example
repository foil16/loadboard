# MongoDB connection string (database name used by the app: loadboarddb)
MONGODB_URI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/?retryWrites=true&w=majority

# MQTT broker that publishes the Start / Truck / Load / End events (topic: CodeJam)
MQTT_URL=mqtt://your-broker:1883
MQTT_USERNAME=
MQTT_PASSWORD=
